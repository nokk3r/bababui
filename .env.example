# Адрес, на котором публикуется интерфейс. 127.0.0.1 — только эта машина.
BIND_HOST=127.0.0.1
# Порт на машине. Внутри контейнера сервис всегда слушает 8080.
PORT=8080

# Пустой пароль оставляет веб-интерфейс открытым на опубликованном адресе.
WEB_PASSWORD=

# Уровень наших логов: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# INFO пишет строку на каждый узел. WARNING оставляет только сбои.
LOG_LEVEL=WARNING
